# Copy to .env once on a new checkout. Never commit .env.
# Root Compose is for local integration, not production.
MYSQL_DATABASE=maple_hush_admin
MYSQL_USER=maple_admin
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET_BASE64=
ADMIN_USERNAME=admin
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=8081
APP_AUTH_ALLOWED_ORIGIN=http://localhost:8081
# Override this only when starting the root frontend by itself against another backend.
API_UPSTREAM=http://backend:8080
OSS_ENABLED=false
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
